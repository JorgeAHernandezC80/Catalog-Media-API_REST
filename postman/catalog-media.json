                "exec": [
                  "pm.test(\"Rechaza serial duplicado (409)\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "URL inválida → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "media"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serial\": \"MED-URL-{{$timestamp}}\",\n  \"titulo\": \"Interestelar\",\n  \"sinopsis\": \"Un grupo de exploradores viaja a través de un agujero de gusano en busca de un nuevo hogar para la humanidad.\",\n  \"url\": \"esto no es una url\",\n  \"portada\": \"https://image.tmdb.org/t/p/w500/interestelar.jpg\",\n  \"anoEstreno\": 2014,\n  \"genero\": \"{{generoId}}\",\n  \"director\": \"{{directorId}}\",\n  \"productora\": \"{{productoraId}}\",\n  \"tipo\": \"{{tipoId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
