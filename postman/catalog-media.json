    {
      "name": "Reglas de negocio (casos de error)",
      "description": "Cada petición debe FALLAR con el código indicado. Si pasan los tests, la regla se cumple.",
      "item": [
        {
          "name": "Serial duplicado → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/media",
