    {
      "name": "Media (Películas y Series)",
      "item": [
        {
          "name": "1. Crear Media",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "media"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serial\": \"{{serial}}\",\n  \"titulo\": \"Interestelar\",\n  \"sinopsis\": \"Un grupo de exploradores viaja a través de un agujero de gusano en busca de un nuevo hogar para la humanidad.\",\n  \"url\": \"{{mediaUrl}}\",\n  \"portada\": \"https://image.tmdb.org/t/p/w500/interestelar.jpg\",\n  \"anoEstreno\": 2014,\n  \"genero\": \"{{generoId}}\",\n  \"director\": \"{{directorId}}\",\n  \"productora\": \"{{productoraId}}\",\n  \"tipo\": \"{{tipoId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Serial y URL únicos en cada ejecución para poder correr la colección varias veces",
                  "const sufijo = Date.now();",
                  "pm.collectionVariables.set(\"serial\", \"MED-\" + sufijo);",
                  "pm.collectionVariables.set(\"mediaUrl\", \"https://www.youtube.com/watch?v=demo\" + sufijo);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201 Created\", () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.expect(data).to.have.property(\"_id\");",
                  "pm.collectionVariables.set(\"mediaId\", data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Listar catálogo",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/media",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "media"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Las relaciones vienen pobladas\", () => {",
                  "    const item = pm.response.json().find(m => m._id === pm.collectionVariables.get(\"mediaId\"));",
                  "    pm.expect(item.genero).to.have.property(\"nombre\");",
                  "    pm.expect(item.director).to.have.property(\"nombres\");",
                  "});"
                ]
              }
            }
          ]
        },
